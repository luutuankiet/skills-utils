# Identifying values that must never reach a public commit, issue or PR.
# A leak scanner checks public text for each value and writes it as $KEY instead. Values live in .env (gitignored).
# what: hostname of the docker devcontainer host where this repo is checked out | group: hosts
HOST_DEVBOX=
# what: homelab docker host and main server (tailnet name) | group: hosts
HOST_HOMELAB=
# what: LAN hostname the cc-web UI is served on for the devbox | group: hosts
HOST_CCWEB_LAN=
# what: operator's primary personal email, shown in Claude Code's status line | group: people
EMAIL_PRIMARY=
# what: operator's secondary email, seen in screenshots of another session | group: people
EMAIL_SECONDARY=
